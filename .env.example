PORT=3000
DATABASE_PATH=./data/dev.db
API_KEY=replace-with-a-long-random-string
AVAILABILITY_CACHE_TTL_SECONDS=30
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# N8N
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# OpenAI (used by N8N's AI Agent, Whisper STT, TTS and Moderation nodes)
OPENAI_API_KEY=replace-with-your-openai-api-key

# Gmail (optional — only needed to send real confirmation e-mails instead of
# Mailpit). Create an OAuth2 Client ID in Google Cloud Console (Gmail API
# enabled) and set the redirect URI to
# http://localhost:5678/rest/oauth2-credential/callback.
# Leave both blank to keep using Mailpit; the N8N workflow picks the SMTP
# (Mailpit) branch automatically when these are empty.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
