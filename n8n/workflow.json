      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [2140, 700],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_API_BASE_URL }}/appointments",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "parametersHeaders": {
          "values": [
