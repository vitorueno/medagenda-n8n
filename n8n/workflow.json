        "sendBody": true,
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            { "name": "patientId", "valueProvider": "modelRequired" },
            { "name": "slotId", "valueProvider": "modelRequired" }
          ]
        },
        "placeholderDefinitions": {
          "values": [
            {
              "name": "patientId",
              "description": "id do paciente, obtido via identificar_paciente",
              "type": "number"
            },
            {
              "name": "slotId",
              "description": "id do horário, obtido via consultar_disponibilidade",
              "type": "number"
            }
          ]
        },
        "toolDescription": "Cria um agendamento para um paciente em um horário específico. Só chame depois de confirmar o patientId (via identificar_paciente) e o slotId (via consultar_disponibilidade). Retorna o agendamento criado ou um erro se o horário não estiver mais disponível."
      }
