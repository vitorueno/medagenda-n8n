        "emailFormat": "text",
        "text": "={{ $json.tipoOperacao === 'agendamento' ? 'Sua consulta foi agendada com sucesso. Detalhes: ' + JSON.stringify($json.agendamento) : 'Sua consulta foi cancelada. Detalhes: ' + JSON.stringify($json.agendamento) }}",
        "options": {}
