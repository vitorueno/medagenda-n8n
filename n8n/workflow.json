            {
              "name": "x-api-key",
              "valueProvider": "fieldValue",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "specifyQuery": "keypair",
        "parametersQuery": {
          "values": [
            { "name": "date", "valueProvider": "modelRequired" },
            { "name": "specialty", "valueProvider": "modelOptional" },
            { "name": "doctorId", "valueProvider": "modelOptional" }
          ]
        },
        "placeholderDefinitions": {
          "values": [
            { "name": "date", "description": "data no formato YYYY-MM-DD", "type": "string" },
            {
              "name": "specialty",
              "description": "especialidade médica, se informada",
              "type": "string"
            },
            { "name": "doctorId", "description": "id do médico, se informado", "type": "number" }
          ]
        },
        "toolDescription": "Consulta horários disponíveis para uma data, opcionalmente filtrando por especialidade ou médico. Retorna uma lista de horários com id do slot, médico e especialidade. Nunca invente horários que não estejam nesta lista."
      }
